@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .

<urn:davidian:brownstone-100>
    a lv2:Plugin , lv2:AmplifierPlugin , lv2:SimulatorPlugin ;
    doap:name "Davidian Brownstone 100" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    rdfs:comment "Tube amplifier simulation modeled on the circuit of a classic high-gain valve head: 12AX7 preamp cascade, FMV tone stack, long-tail phase inverter and 6L6GC push-pull power amp with presence/resonance negative feedback. 4x oversampled." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "channel" ;
        lv2:name "Channel" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Rhythm" ; rdf:value 0 ] ,
                       [ rdfs:label "Rhythm Crunch" ; rdf:value 1 ] ,
                       [ rdfs:label "Lead" ; rdf:value 2 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "input_low" ;
        lv2:name "Low Input" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "rhythm_pre" ;
        lv2:name "Rhythm Pre" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "rhythm_post" ;
        lv2:name "Rhythm Post" ;
        lv2:default 6 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "lead_pre" ;
        lv2:name "Lead Pre" ;
        lv2:default 6 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "lead_post" ;
        lv2:name "Lead Post" ;
        lv2:default 3 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "low" ;
        lv2:name "Low" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mid" ;
        lv2:name "Mid" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "high" ;
        lv2:name "High" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "presence" ;
        lv2:name "Presence" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "cab" ;
        lv2:name "Cabinet Sim" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "input_trim" ;
        lv2:name "Input Trim" ;
        lv2:default 0 ;
        lv2:minimum -24 ;
        lv2:maximum 24 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "output" ;
        lv2:name "Output Level" ;
        lv2:default 0 ;
        lv2:minimum -60 ;
        lv2:maximum 12 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "cab_model" ;
        lv2:name "Cabinet Model" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "4x12 Modern" ; rdf:value 0 ] ,
                       [ rdfs:label "4x12 Vintage" ; rdf:value 1 ] ,
                       [ rdfs:label "2x12 Open Back" ; rdf:value 2 ] ,
                       [ rdfs:label "1x12 Combo" ; rdf:value 3 ]
    ] .
